# Public URL of the deployed site (no trailing slash).
# Used for canonical URLs, Open Graph, sitemap.xml and robots.txt.
# Optional: defaults to the Vercel production domain (https://blue-team-five.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Business contact email. The contact form opens the visitor's email app
# (mailto:) addressed to this inbox. No data is sent to any server.
# Defaults to jordigw@gmail.com when empty.
NEXT_PUBLIC_CONTACT_EMAIL=jordigw@gmail.com

# Floating style navigation (main site ↔ /designs proposals).
# Set to "false" before sending the site to brands.
NEXT_PUBLIC_STYLE_NAV=true

# Optional scheduling link for a 15-minute intro call (Calendly, Cal.com, Google Calendar…).
# Shown on /contact and on brand proposal pages when set.
NEXT_PUBLIC_BOOKING_URL=

# Vercel Web Analytics (cookieless, aggregated). Set to "true" and enable
# Analytics in the Vercel project. Lets you see visits to each /proposal/<brand> page.
NEXT_PUBLIC_ANALYTICS=false
